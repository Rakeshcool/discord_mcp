# Discord MCP server — environment variables.
#
# Variable NAMES only. Never commit real values to this file; copy it to `.env`
# (git-ignored) or set the variables in the MCP client's environment block.
# The server does not read `.env` files by itself.

# Required for `serve`. The bot token from the Discord Developer Portal.
# Never a user token, never a password.
DISCORD_BOT_TOKEN=

# Optional. Path to a TOML configuration file. Omit to use the built-in
# defaults in config/default.toml.
DISCORD_MCP_CONFIG=

# Bearer token for the Streamable HTTP transport. Required when
# `http.require_auth` is true (the default); refused if shorter than 16
# characters. At least 32 random characters is recommended.
DISCORD_MCP_HTTP_TOKEN=

# Optional. Log filter override, for example `info` or `discord_mcp=debug`.
RUST_LOG=
