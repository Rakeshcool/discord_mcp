# Local secrets for the live run. Git-ignored, never committed, never printed.
#
# Paste the bot token from Discord Developer Portal -> your application -> Bot
# -> Reset Token, directly after the `=` with no quotes and no `Bot ` prefix.
DISCORD_BOT_TOKEN=

# Bearer token for the Streamable HTTP transport (32+ random characters).
# Used only when testing `server.transport = "http"`.
DISCORD_MCP_HTTP_TOKEN=